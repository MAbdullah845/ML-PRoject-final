# Bazaar PSX Terminal - Environment Configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Application
APP_NAME=Bazaar PSX Terminal
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bazaar
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/bazaar

# PyPSX credentials - issued at https://markets.pypsx.com (dashboard > API Keys)
# Paper keys start with PK_, live keys start with AK_
PYPSX_API_KEY_ID=PK_YOUR_KEY_ID_HERE
PYPSX_API_SECRET_KEY=YOUR_SECRET_KEY_HERE
# Alternative to key+secret: a JWT/token
PYPSX_API_TOKEN=

# Keep True unless you intend to trade real money
PYPSX_PAPER=True
# Extra safety gate: order submission is blocked when paper mode is off
# and this stays False
ALLOW_LIVE_TRADING=False
# Set True to serve live PSX data instead of generated mock data
USE_PYPSX=True

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379
